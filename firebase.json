{
  "hosting": {
    "public": ".",
    "predeploy": ["node tools/validate-data.mjs"],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/.*/**",
      ".git/**",
      "**/node_modules/**",
      "tools/**",
      "*.rules",
      "**/*.tmp",
      "**/*.log"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|webp|gif|svg|ico|ttf|woff|woff2|mp4)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      },
      {
        "source": "data/@(schedule|site-events).json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Content-Type", "value": "application/json; charset=utf-8" }
        ]
      },
      {
        "source": "data/@(anime|anime-synonyms).json",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" },
          { "key": "Content-Type", "value": "application/json; charset=utf-8" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
